{
  "name": "@cinder/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prebuild-sdk.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prebuild-sdk.mjs",
    "build": "npm run generate:sitemap && vite build && npx playwright install --with-deps chromium && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "node scripts/prebuild-sdk.mjs && tsc -p tsconfig.json --noEmit",
    "validate:links": "node scripts/validate-docs.mjs",
    "validate:api-coverage": "node scripts/validate-api-coverage.mjs",
    "validate:docs-freshness": "node scripts/validate-docs-freshness.mjs",
    "validate:docs": "npm run validate:links && npm run validate:api-coverage && npm run validate:docs-freshness",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "usecinder": "^0.1.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "playwright": "1.65.1",
    "postcss": "^8.4.49",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
