{
  "name": "usecinder",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Cinder: a semantic runtime for websites you control. Tag the app, build a local graph, resolve commands locally, and fall back to AI only when genuinely needed.",
  "repository": {
    "type": "git",
    "url": "https://github.com/harry-sandhu/usecinder.git",
    "directory": "packages/cinder"
  },
  "homepage": "https://usecinder.dev",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cinder/shared": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
